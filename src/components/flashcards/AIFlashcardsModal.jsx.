import { useState } from "react";
import { base44 } from "@/api/base44Client";
import { todayStr, SUBJECTS } from "@/lib/studyUtils";
import { Sparkles, X, Trash2, Loader2 } from "lucide-react";

export default function AIFlashcardsModal({ onClose, onCreated }) {
  const [notes, setNotes] = useState("");
  const [subject, setSubject] = useState("biology");
  const [name, setName] = useState("");
  const [cards, setCards] = useState(null);
  const [generating, setGenerating] = useState(false);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");

  const generate = async () => {
    if (!notes.trim()) return;
    setGenerating(true);
    setError("");
    try {
      const res = await base44.functions.invoke("generateFlashcards", { notes: notes.trim(), subject });
      const got = res.data?.cards || [];
      if (!got.length) {
        setError("No cards came back — try pasting a bit more detail.");
      } else {
        setCards(got);
        if (!name.trim()) setName(`${SUBJECTS[subject].label} — AI deck`);
      }
    } catch (e) {
      setError(e?.response?.data?.error || "Couldn't generate cards right now. Please try again.");
    }
    setGenerating(false);
  };

  const removeCard = (index) => {
    setCards((prev) => prev.filter((_, i) => i !== index));
  };

  const save = async () => {
    if (!name.trim() || !cards?.length) return;
    setSaving(true);
    setError("");
    try {
      const deck = await base44.entities.Deck.create({ name: name.trim(), subject });
      await base44.entities.Flashcard.bulkCreate(
        cards.map((c) => ({
          deck_id: deck.id,
          front: c.front,
          back: c.back,
          ease: 2.5,
          interval: 0,
          reps: 0,
          lapses: 0,
          due_date: todayStr(),
        }))
      );
      onCreated();
    } catch (e) {
      setError("Couldn't save the deck. Please try again.");
      setSaving(false);
    }
  };

  return (
    <div className="fixed inset-0 bg-black/30 flex items-center justify-center z-50 p-4" onClick={onClose}>
      <div
        className="bg-white rounded-2xl p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto"
        onClick={(e) => e.stopPropagation()}
      >
        <div className="flex items-center justify-between mb-4">
          <div className="flex items-center gap-2">
            <div className="h-9 w-9 rounded-xl bg-gradient-to-br from-indigo-500 to-emerald-500 flex items-center justify-center">
              <Sparkles size={18} className="text-white" />
            </div>
            <h2 className="text-xl font-semibold">Generate with AI</h2>
          </div>
          <button onClick={onClose} aria-label="Close">
            <X size={20} className="text-neutral-400" />
          </button>
        </div>

        {!cards ? (
          <div className="space-y-3">
            <textarea
              value={notes}
              onChange={(e) => setNotes(e.target.value)}
              placeholder="Paste your revision notes here — a page of the textbook, your class notes, anything."
              rows={10}
              className="w-full rounded-xl border border-neutral-200 p-3 text-sm resize-none focus:outline-none focus:border-neutral-900"
            />
            <div className="flex gap-2">
              <select
                value={subject}
                onChange={(e) => setSubject(e.target.value)}
                className="flex-1 rounded-xl border border-neutral-200 p-3 text-sm bg-white focus:outline-none focus:border-neutral-900"
              >
                {Object.entries(SUBJECTS).map(([k, v]) => (
                  <option key={k} value={k}>
                    {v.label}
                  </option>
                ))}
              </select>
              <input
                value={name}
                onChange={(e) => setName(e.target.value)}
                placeholder="Deck name (optional)"
                className="flex-1 rounded-xl border border-neutral-200 p-3 text-sm focus:outline-none focus:border-neutral-900"
              />
            </div>

            {error && <div className="text-sm text-red-600 bg-red-50 rounded-xl p-3">{error}</div>}

            <button
              onClick={generate}
              disabled={generating || !notes.trim()}
              className="w-full py-2.5 rounded-xl bg-neutral-900 text-white font-medium disabled:opacity-50 flex items-center justify-center gap-2"
            >
              {generating ? (
                <>
                  <Loader2 size={16} className="animate-spin" /> Generating cards…
                </>
              ) : (
                <>
                  <Sparkles size={16} /> Generate
                </>
              )}
            </button>
          </div>
        ) : (
          <div className="space-y-3">
            <div className="text-sm text-neutral-500">
              {cards.length} cards generated — remove any you don't want, then save.
            </div>
            <input
              value={name}
              onChange={(e) => setName(e.target.value)}
              placeholder="Deck name"
              className="w-full rounded-xl border border-neutral-200 p-3 text-sm focus:outline-none focus:border-neutral-900"
            />
            <div className="space-y-2 max-h-[45vh] overflow-y-auto pr-1">
              {cards.map((c, i) => (
                <div
                  key={i}
                  className="bg-neutral-50 rounded-xl border border-neutral-200 p-3 flex items-start justify-between gap-3"
                >
                  <div className="flex-1 min-w-0">
                    <div className="font-medium text-sm">{c.front}</div>
                    <div className="text-sm text-neutral-500 mt-1">{c.back}</div>
                  </div>
                  <button
                    onClick={() => removeCard(i)}
                    className="text-neutral-300 hover:text-red-500 shrink-0"
                    aria-label="Remove card"
                  >
                    <Trash2 size={16} />
                  </button>
                </div>
              ))}
            </div>

            {error && <div className="text-sm text-red-600 bg-red-50 rounded-xl p-3">{error}</div>}

            <div className="flex gap-2">
              <button
                onClick={generate}
                disabled={generating}
                className="flex-1 py-2.5 rounded-xl border border-neutral-200 font-medium disabled:opacity-50"
              >
                {generating ? "Regenerating…" : "Regenerate"}
              </button>
              <button
                onClick={save}
                disabled={saving || !name.trim() || cards.length === 0}
                className="flex-1 py-2.5 rounded-xl bg-neutral-900 text-white font-medium disabled:opacity-50"
              >
                {saving ? "Saving…" : `Save deck (${cards.length})`}
              </button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
